{
  "name": "frontend",
  "version": "0.0.0",
  "prettier": "@openmfp/config-prettier",
  "scripts": {
    "ng": "ng",
    "extract-versions": "node ./build-scripts/extract-versions.js",
    "prebuild": "npm run extract-versions",
    "prebuild:watch": "npm run extract-versions",
    "prestart": "npm run extract-versions",
    "prestart:watch": "npm run extract-versions",
    "start": "ng serve --port 4300",
    "start:watch": "nodemon --watch .yalc -e * --exec \"rimraf .angular && ng serve --watch --port 4300\"",
    "build": "ng build",
    "build:watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.7",
    "@angular/common": "21.2.7",
    "@angular/compiler": "21.2.7",
    "@angular/core": "21.2.7",
    "@angular/elements": "21.2.7",
    "@angular/forms": "21.2.7",
    "@angular/localize": "21.2.7",
    "@angular/platform-browser": "21.2.7",
    "@angular/platform-browser-dynamic": "21.2.7",
    "@angular/router": "21.2.7",
    "@luigi-project/client": "2.29.0",
    "@luigi-project/core": "2.29.0",
    "@luigi-project/plugin-auth-oauth2": "2.29.0",
    "@openmfp/portal-ui-lib": "0.192.21",
    "@platform-mesh/portal-ui-lib": "0.44.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.7",
    "@angular/build": "21.2.7",
    "@angular/cli": "21.2.7",
    "@angular/compiler-cli": "21.2.7",
    "@openmfp/config-prettier": "0.9.2",
    "@openmfp/eslint-config-typescript": "0.7.11",
    "jsdom": "29.0.2",
    "nodemon": "3.1.14",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.3"
  },
  "overrides": {
    "underscore": ">=1.13.8"
  }
}
