{
  "name": "frontend",
  "version": "0.0.0",
  "prettier": "@openmfp/config-prettier",
  "scripts": {
    "ng": "ng",
    "extract-versions": "node ./build-scripts/extract-versions.js",
    "prebuild": "npm run extract-versions",
    "prebuild:watch": "npm run extract-versions",
    "prestart": "npm run extract-versions",
    "prestart:watch": "npm run extract-versions",
    "start": "ng serve --port 4300",
    "start:watch": "nodemon --watch .yalc -e * --exec \"rimraf .angular && ng serve --watch --port 4300\"",
    "build": "ng build",
    "build:watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.0.6",
    "@angular/common": "21.0.6",
    "@angular/compiler": "21.0.6",
    "@angular/core": "21.0.6",
    "@angular/elements": "21.0.6",
    "@angular/forms": "21.0.6",
    "@angular/localize": "21.0.6",
    "@angular/platform-browser": "21.0.6",
    "@angular/platform-browser-dynamic": "21.0.6",
    "@angular/router": "21.0.6",
    "@fundamental-ngx/cdk": "0.57.5",
    "@fundamental-ngx/core": "0.57.5",
    "@fundamental-ngx/i18n": "0.57.5",
    "@luigi-project/client": "2.26.0",
    "@luigi-project/core": "2.26.0",
    "@luigi-project/plugin-auth-oauth2": "2.26.0",
    "@openmfp/portal-ui-lib": "0.184.22",
    "@platform-mesh/portal-ui-lib": "0.24.3",
    "@ui5/webcomponents-ngx": "0.5.9",
    "jmespath": "0.16.0",
    "jwt-decode": "4.0.0",
    "lodash": "4.17.21",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-builders/jest": "20.0.0",
    "@angular-devkit/build-angular": "21.0.3",
    "@angular/build": "21.0.3",
    "@angular/cli": "21.0.3",
    "@angular/compiler-cli": "21.0.6",
    "@openmfp/config-prettier": "0.9.2",
    "@openmfp/eslint-config-typescript": "0.7.7",
    "@types/jest": "30.0.0",
    "jest": "30.2.0",
    "nodemon": "3.1.11",
    "rimraf": "6.1.2",
    "typescript": "5.9.3"
  }
}
