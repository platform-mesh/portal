    "@nestjs/platform-express": "11.1.18",
    "@nestjs/serve-static": "5.0.5",
    "@openmfp/portal-server-lib": "0.163.24",
    "@platform-mesh/portal-server-lib": "0.8.31",
    "axios": "1.16.0",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "graphql-request": "7.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.19",
